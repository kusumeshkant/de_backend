# ─────────────────────────────────────────────────────────────────────────────
# DQ Backend — Environment Variables
# Copy this file to .env and fill in your values.
# .env is git-ignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string
# Create a database user in Atlas > Database Access and replace credentials.
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/dq_app?retryWrites=true&w=majority

# Server port (defaults to 4000 if not set)
PORT=4000

# Node environment: development | production
# Controls CORS strictness, schema validation, introspection.
NODE_ENV=development

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Option A (local dev): path to downloaded service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# Option B (cloud deploy): paste the entire JSON content as a single-line string
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# ── Razorpay ──────────────────────────────────────────────────────────────────
# Use rzp_test_* keys for development/UAT.
# Use rzp_live_* keys for production only — never commit live keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Email — Gmail SMTP (staff invite emails) ─────────────────────────────────
# Generate an App Password in Google Account > Security > 2-Step Verification > App passwords.
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Email — Resend API (transactional emails) ─────────────────────────────────
# Create an API key at resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Azure Application Insights (optional, production monitoring) ──────────────
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
